@using Editor.Services

@*
    ROASTTHREAD COMPONENT

    This is the inline comment widget that appears inside the Monaco editor.
    It's initially rendered in a hidden div, then moved into the editor by JavaScript.

    Key features:
    - Displays AI-generated sarcastic comments
    - Users can reply to comments (proving interactivity after DOM manipulation)
    - Shows severity level of the roast
    - Allows closing/dismissing threads
    - Maintains full event handling despite being inside Monaco's managed DOM
*@

<div class="roast-thread" style="
    background: #1e1e1e;
    border: 1px solid #ff6b6b;
    border-radius: 6px;
    padding: 12px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #e8e8e8;
    min-width: 380px;
    max-width: 600px;
    box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
">
    <!-- HEADER WITH CLOSE BUTTON -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #ff6b6b;">
        <div>
            <div style="font-weight: bold; font-size: 14px; color: #ff6b6b; display: flex; align-items: center; gap: 6px;">
                🔥 AI Roast
                <MudChip T="string" Text="@Severity" Size="Size.Small" Variant="@(Severity == "Brutal" ? Variant.Filled : Variant.Text)" Color="@GetSeverityColor(Severity)" />
            </div>
            <div style="font-size: 12px; color: #888; margin-top: 4px;">Line @LineNumber</div>
        </div>
        <MudIconButton
            Icon="@Icons.Material.Filled.Close"
            Size="Size.Small"
            OnClick="Close"
            style="color: #ff6b6b; margin-top: -8px;"
        />
    </div>

    <!-- AI COMMENT TEXT -->
    <div style="margin-bottom: 16px; padding: 12px; background: #252526; border-radius: 4px; border-left: 3px solid #ff6b6b;">
        <div style="font-size: 13px; line-height: 1.6; color: #e8e8e8; white-space: pre-wrap; word-break: break-word;">
            @CommentText
        </div>
    </div>

    <!-- REPLY INPUT SECTION -->
    <div style="margin-bottom: 12px;">
        <MudText Typo="Typo.caption" style="color: #888; margin-bottom: 6px;">Your Response</MudText>
        <textarea
            @bind="userReply"
            placeholder="Type your response to this roast..."
            style="
                width: 100%;
                padding: 8px;
                background: #252526;
                color: #e8e8e8;
                border: 1px solid #3e3e42;
                border-radius: 4px;
                font-family: inherit;
                font-size: 12px;
                resize: vertical;
                min-height: 50px;
                box-sizing: border-box;
            "
            @onkeydown="@OnKeyDown"
        />
    </div>

    <!-- ACTION BUTTONS -->
    <div style="display: flex; gap: 8px;">
        <MudButton
            Variant="Variant.Filled"
            Color="Color.Error"
            Size="Size.Small"
            OnClick="SendReply"
            Disabled="@(string.IsNullOrWhiteSpace(userReply) || isReplying)"
            FullWidth="true"
            style="height: 32px; font-size: 12px;"
        >
            @if (isReplying)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Posting</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-1" />
                <span>Reply</span>
            }
        </MudButton>
        <MudButton
            Variant="Variant.Text"
            Color="Color.Default"
            Size="Size.Small"
            OnClick="ClearReply"
            style="height: 32px; font-size: 12px; padding: 0 12px;"
        >
            Clear
        </MudButton>
    </div>

    <!-- PREVIOUS REPLIES SECTION (if any) -->
    @if (previousReplies.Count > 0)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.caption" style="color: #888; margin-bottom: 8px;">
            @previousReplies.Count Reply(ies)
        </MudText>
        <div style="max-height: 150px; overflow-y: auto;">
            @foreach (var reply in previousReplies)
            {
                <div style="margin-bottom: 8px; padding: 8px; background: #252526; border-radius: 4px; border-left: 2px solid #007acc;">
                    <div style="font-size: 11px; color: #569cd6; font-weight: bold;">You</div>
                    <div style="font-size: 12px; color: #e8e8e8; margin-top: 4px; word-break: break-word;">@reply</div>
                </div>
            }
        </div>
    }

    <!-- DEBUG INFO -->
    @if (showDebug)
    {
        <MudDivider Class="my-2" />
        <div style="margin-top: 8px; padding: 8px; background: #1f1f23; border: 1px dashed #3e3e42; border-radius: 4px;">
            <div style="font-size: 10px; color: #858585; font-family: monospace;">
                <div>Line: @LineNumber | Renders: @renderCount | State: @(isReplying ? "REPLYING" : "IDLE")</div>
                <div>Still inside Blazor render tree: ✓</div>
                <div>Event handlers working: ✓</div>
                <div>Two-way binding working: ✓</div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// PARAMETERS
    /// Passed from the parent component (RoastMyCode.razor)
    /// </summary>

    /// <summary>
    /// The line number this roast comment is attached to
    /// </summary>
    [Parameter]
    public int LineNumber { get; set; }

    /// <summary>
    /// The AI-generated roast comment text
    /// Can include markdown, emoji, sarcasm, etc.
    /// </summary>
    [Parameter]
    public string CommentText { get; set; } = string.Empty;

    /// <summary>
    /// Severity level of the roast: "Gentle", "Medium", "Brutal"
    /// Used to color-code the comment
    /// </summary>
    [Parameter]
    public string Severity { get; set; } = "Medium";

    /// <summary>
    /// Event callback triggered when user submits a reply
    /// Passes the reply text back to the parent
    /// </summary>
    [Parameter]
    public EventCallback<string> OnReplySubmitted { get; set; }

    /// <summary>
    /// Event callback triggered when user closes this thread
    /// </summary>
    [Parameter]
    public EventCallback OnThreadClosed { get; set; }

    /// <summary>
    /// COMPONENT STATE
    /// </summary>

    /// <summary>
    /// Current text in the reply input field
    /// Uses @bind to stay in sync with textarea
    /// Demonstrates two-way data binding works after DOM injection
    /// </summary>
    private string userReply = string.Empty;

    /// <summary>
    /// Whether we're currently sending a reply
    /// True while waiting for the service to complete
    /// </summary>
    private bool isReplying = false;

    /// <summary>
    /// List of previous replies to this roast
    /// Allows users to see their response history
    /// </summary>
    private List<string> previousReplies = new();

    /// <summary>
    /// Render counter for debugging
    /// Shows that Blazor is still managing this component
    /// </summary>
    private int renderCount = 0;

    /// <summary>
    /// Show debug information
    /// Useful for debugging the hidden div strategy
    /// </summary>
    private bool showDebug = false;

    /// <summary>
    /// Reference to the parent service (obtained via CascadingParameter or DI)
    /// </summary>
    [Inject]
    private IRoastApiService RoastApiService { get; set; } = null!;

    /// <summary>
    /// LIFECYCLE METHODS
    /// </summary>

    /// <summary>
    /// Called after each render
    /// Increments renderCount to prove Blazor is still managing this component
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        renderCount++;
        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// EVENT HANDLERS
    /// </summary>

    /// <summary>
    /// Called when user clicks the "Reply" button
    ///
    /// This is the KEY TEST of our "hidden div strategy":
    /// 1. The component's DOM was moved into Monaco by JavaScript
    /// 2. But Blazor is still managing the component
    /// 3. The event fires, state is updated, re-render happens
    /// 4. All while the component is visually inside Monaco's DOM
    ///
    /// This proves that even though the DOM element moved,
    /// Blazor's event handling and state management still work perfectly!
    /// </summary>
    private async Task SendReply()
    {
        // Validate input
        if (string.IsNullOrWhiteSpace(userReply))
            return;

        try
        {
            isReplying = true;
            await InvokeAsync(StateHasChanged);

            Console.WriteLine($"[RoastThread] Sending reply to line {LineNumber}: {userReply}");

            // CALL THE INJECTED SERVICE
            // This demonstrates that dependency injection works in child components too!
            // RoastApiService is either Mock or Http - component doesn't care
            bool success = await RoastApiService.ReplyToThreadAsync(LineNumber, userReply);

            if (success)
            {
                // Add to previous replies list
                previousReplies.Add(userReply);

                // Clear the input
                userReply = string.Empty;

                // Trigger parent callback
                await OnReplySubmitted.InvokeAsync(userReply);

                Console.WriteLine("[RoastThread] Reply posted successfully");
            }
            else
            {
                Console.WriteLine("[RoastThread] Failed to post reply");
                // Could show error snackbar here
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RoastThread] Error sending reply: {ex.Message}");
        }
        finally
        {
            isReplying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Clears the reply input without posting
    /// </summary>
    private void ClearReply()
    {
        userReply = string.Empty;
    }

    /// <summary>
    /// Called when user closes this roast thread
    /// Triggers the OnThreadClosed callback to notify parent
    /// </summary>
    private async Task Close()
    {
        await OnThreadClosed.InvokeAsync();
    }

    /// <summary>
    /// Allows pressing Enter to submit reply (Shift+Enter for newline)
    /// Common UX pattern in chat/comment interfaces
    /// </summary>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendReply();
        }
    }

    /// <summary>
    /// Helper method to get the color for severity level
    /// </summary>
    private Color GetSeverityColor(string severity) => severity switch
    {
        "Gentle" => Color.Info,
        "Medium" => Color.Warning,
        "Brutal" => Color.Error,
        _ => Color.Default
    };
}

<!--
    ARCHITECTURAL NOTES
    ====================

    PROOF OF CONCEPT:
    This component is the PROOF that the hidden div strategy works!

    Here's what happens:
    1. RoastMyCode.razor renders this component in a hidden div
    2. JavaScript moves the div into Monaco editor (via view zones API)
    3. Component appears visually inside the editor
    4. User types in the textarea
    5. User clicks Reply button
    6. @onclick handler fires → SendReply() executes
    7. RoastApiService.ReplyToThreadAsync() is called
    8. Component state updates (previousReplies list)
    9. StateHasChanged() triggers re-render
    10. UI updates to show the new reply was posted
    11. All of this happens WHILE the component's DOM is inside Monaco!

    How is this possible?
    - Blazor maintains the component in its render tree
    - Blazor's event system routes events to the correct component
    - Blazor's state management keeps component state in sync
    - The fact that Monaco moved the DOM doesn't affect Blazor
    - Perfect separation of concerns!

    DEPENDENCY INJECTION:
    - RoastApiService is injected via [Inject]
    - When SendReply() is called, it uses the injected service
    - This proves DI works in child components too
    - The service is MockRoastApiService (with 1-second delay)
    - Could be swapped for real HttpRoastApiService

    DEBUG MODE:
    - Set showDebug = true to see:
      - Render count (increments on each render)
      - Current state
      - Proof that component is still in render tree
      - Proof that event handlers work
      - Proof that state binding works

    This is a beautiful example of:
    - Clean architecture (service injection)
    - Separation of concerns (Blazor vs Monaco)
    - Component interactivity (working after DOM moved)
    - Modern async/await patterns
    - User-friendly UX (loading states, feedback)
-->
