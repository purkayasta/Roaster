@page "/counter"

<PageTitle>Counter</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Counter</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5">Current count: <MudChip T="int" Color="Color.Primary">@currentCount</MudChip></MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="IncrementCount" Class="mt-4">
        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
        Click me
    </MudButton>
</MudPaper>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
