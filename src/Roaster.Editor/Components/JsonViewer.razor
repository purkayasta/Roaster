@using System.Text.Json
@implements IDisposable

@if (_lines.Count > 0)
{
    <MudPaper Outlined="true" Class="pa-3" Style="font-family:monospace; font-size:12px; overflow-x:auto;">
        @foreach (var line in _lines)
        {
            <div style="padding-left:@(line.Indent * 16)px; line-height:1.7; white-space:nowrap;">
                @if (line.Key is not null)
                {
                    <span style="color:#79c0ff;">@line.Key</span>
                    <span style="opacity:0.4; padding:0 2px;">:</span>
                }
                <span style="color:@line.Color;">@line.Value</span>
            </div>
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public string? Json { get; set; }

    private readonly record struct JsonLine(int Indent, string? Key, string Value, string Color);
    private List<JsonLine> _lines = [];
    private JsonDocument? _doc;
    private string? _lastJson;

    protected override void OnParametersSet()
    {
        if (Json == _lastJson) return;
        _lastJson = Json;

        _doc?.Dispose();
        _doc = null;
        _lines = [];
        if (string.IsNullOrWhiteSpace(Json)) return;
        try
        {
            _doc = JsonDocument.Parse(Json);
            _lines = Flatten(_doc.RootElement, 0);
        }
        catch { }
    }

    private static List<JsonLine> Flatten(JsonElement el, int depth, string? key = null)
    {
        var lines = new List<JsonLine>();
        switch (el.ValueKind)
        {
            case JsonValueKind.Object:
                if (key is not null) lines.Add(new(depth, key, "{", "#8b949e"));
                foreach (var prop in el.EnumerateObject())
                    lines.AddRange(Flatten(prop.Value, key is not null ? depth + 1 : depth, prop.Name));
                if (key is not null) lines.Add(new(depth, null, "}", "#8b949e"));
                break;

            case JsonValueKind.Array:
                if (key is not null) lines.Add(new(depth, key, "[", "#8b949e"));
                var i = 0;
                foreach (var item in el.EnumerateArray())
                    lines.AddRange(Flatten(item, key is not null ? depth + 1 : depth, $"[{i++}]"));
                if (key is not null) lines.Add(new(depth, null, "]", "#8b949e"));
                break;

            default:
                var (value, color) = el.ValueKind switch
                {
                    JsonValueKind.String => ($"\"{el.GetString()}\"", "#a5d6ff"),
                    JsonValueKind.Number => (el.GetRawText(),          "#ffa657"),
                    JsonValueKind.True   => ("true",                   "#79c0ff"),
                    JsonValueKind.False  => ("false",                  "#79c0ff"),
                    JsonValueKind.Null   => ("null",                   "#8b949e"),
                    _                    => (el.GetRawText(),          "inherit")
                };
                lines.Add(new(depth, key, value, color));
                break;
        }
        return lines;
    }

    public void Dispose() => _doc?.Dispose();
}
