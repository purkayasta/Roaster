@page "/code"
@inherits EditorComponentBase
@inject SessionService SessionService

<PageTitle>Submissions</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Submissions</MudText>

    <MudDataGrid T="SessionSubmissionResponse" ServerData="LoadServerDataAsync" Filterable="false" SortMode="SortMode.None" Groupable="false"
                 Hover="true" Striped="true">
        <Columns>
            <PropertyColumn Property="x => x.SessionName" Title="Session" />
            <PropertyColumn Property="x => x.Language" Title="Language" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
            <PropertyColumn Property="x => x.SessionCreatedAt" Title="Created At" Format="yyyy-MM-dd HH:mm" />
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4">No submissions found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="SessionSubmissionResponse" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    private async Task<GridData<SessionSubmissionResponse>> LoadServerDataAsync(GridState<SessionSubmissionResponse> state, CancellationToken ct)
    {
        var page     = state.Page + 1; // MudDataGrid is 0-based
        var pageSize = state.PageSize;

        var result = await SessionService.GetAllAsync(page, pageSize + 1, ct);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? $"Failed to load submissions ({result.StatusCode}).", Severity.Error);
            return new GridData<SessionSubmissionResponse> { Items = [], TotalItems = 0 };
        }

        var items   = result.Data ?? [];
        var hasMore = items.Count > pageSize;
        if (hasMore) items = items.Take(pageSize).ToList();

        return new GridData<SessionSubmissionResponse>
        {
            Items      = items,
            TotalItems = (page - 1) * pageSize + items.Count + (hasMore ? 1 : 0)
        };
    }
}
