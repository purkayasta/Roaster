@inherits EditorComponentBase
@inject SessionService SessionService

@if (Running)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 60vh;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else
{
    <MudDataGrid T="SessionSubmissionResponse" Items="_submissions" Filterable="false" SortMode="SortMode.None" Groupable="false"
                 Hover="true" Striped="true">
        <Columns>
            <PropertyColumn Property="x => x.SessionName" Title="Session" />
            <PropertyColumn Property="x => x.Language" Title="Language" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
            <PropertyColumn Property="x => x.SessionCreatedAt" Title="Created At" Format="yyyy-MM-dd HH:mm" />
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4">No submissions found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="SessionSubmissionResponse" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private List<SessionSubmissionResponse> _submissions = [];

    protected override async Task OnInitializedAsync()
    {
        await RunLogException(async () =>
        {
            _submissions = await SessionService.GetAllAsync();
        });
    }
}
