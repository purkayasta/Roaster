@inherits EditorComponentBase
@inject SubmissionService SubmissionService
@inject IDialogService DialogService

<MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="OpenNewSessionDialog">
        New
    </MudButton>
</MudStack>

@if (Running)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 60vh;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else
{
    <MudDataGrid T="SubmissionResponse"
                 Items="_submissions"
                 Filterable="false"
                 SortMode="SortMode.None"
                 Groupable="false"
                 Hover="true"
                 Striped="true">
        <Columns>
            <PropertyColumn Property="x => x.Id"        Title="ID" />
            <PropertyColumn Property="x => x.Language"  Title="Language" />
            <PropertyColumn Property="x => x.Status"    Title="Status" />
            <PropertyColumn Property="x => x.CreatedAt" Title="Created At" Format="yyyy-MM-dd HH:mm" />
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4">No submissions found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="SubmissionResponse" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private List<SubmissionResponse> _submissions = [];

    protected override async Task OnInitializedAsync()
    {
        await RunLogException(async () =>
        {
            _submissions = await SubmissionService.GetAllAsync();
        });
    }

    private async Task OpenNewSessionDialog()
    {
        await DialogService.ShowAsync<NewSessionDialog>("New Code Session");
    }
}
