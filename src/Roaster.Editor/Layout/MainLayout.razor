@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<MudThemeProvider Theme="currentTheme" IsDarkMode="isDarkMode" />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@ToggleDarkMode" />
    </MudAppBar>
    <MudDrawer @bind-Open="drawerOpen" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;
    private bool isDarkMode = false;
    private MudTheme currentTheme = new();

    protected override async Task OnInitializedAsync()
    {
        var darkMode = await JS.InvokeAsync<bool>("localStorage.getItem", "mudblazor-darkmode");
        isDarkMode = darkMode;
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "mudblazor-darkmode", isDarkMode);
    }

    private void DrawerToggle()
    {
        drawerOpen = !drawerOpen;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (JS is IAsyncDisposable asyncJs)
            await asyncJs.DisposeAsync();
    }
}
