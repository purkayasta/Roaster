@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_initialized)
{
    <MudLayout>
        <MudAppBar Elevation="0" Dense="false" Color="Color.Inherit"
                   Class="@($"roaster-appbar{(_isDarkMode ? " roaster-appbar-dark" : "")}")">
            <MudText Typo="Typo.h6" Style="font-weight:700; letter-spacing:-0.3px; margin-right:24px;">
                Roaster
            </MudText>
            <MudDivider Vertical="true" FlexItem="true" Style="height:20px; align-self:center; margin-right:12px;" />
            <NavMenu />
            <MudSpacer />
            <MudTooltip Text="@(_isDarkMode ? "Light mode" : "Dark mode")">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="ToggleDarkMode" />
            </MudTooltip>
        </MudAppBar>
        <MudMainContent
            Style="height:calc(100vh - var(--mud-appbar-height)); overflow:hidden; display:flex; flex-direction:column;">
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _isDarkMode;
    private bool _initialized;
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#1976D2" },
        PaletteDark  = new PaletteDark  { Primary = "#1976D2" },
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "mudblazor-darkmode");
        _isDarkMode = stored == "true";
        _initialized = true;
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "mudblazor-darkmode", _isDarkMode.ToString().ToLower());
    }
}
