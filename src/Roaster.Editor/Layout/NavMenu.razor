@inject NavigationManager Navigation

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudButton Href="" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Dashboard"
               Size="Size.Medium" Class="@NavClass("")" Style="border-radius:8px;">
        Dashboard
    </MudButton>
    <MudButton Href="events" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Timeline"
               Size="Size.Medium" Class="@NavClass("events")" Style="border-radius:8px;">
        Event Log
    </MudButton>
</MudStack>

@code {
    private bool IsActive(string href)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        if (href == "") return path == "";
        return path == href || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    private string NavClass(string href) => IsActive(href) ? "roaster-nav-active" : "";
}
