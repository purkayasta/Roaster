@page "/code-editor"

<PageTitle>Code Editor</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Code Editor</MudText>

<MudPaper Class="mb-4" Style="height: 500px; position: relative;">
    <StandaloneCodeEditor @ref="editor" Id="code-editor" ConstructionOptions="EditorConstructionOptions" />
</MudPaper>

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClearCode" FullWidth="true">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" />
            Clear
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GetCode" FullWidth="true">
            <MudIcon Icon="@Icons.Material.Filled.GetApp" Class="mr-2" />
            Get Code
        </MudButton>
    </MudItem>
</MudGrid>

@if (!string.IsNullOrEmpty(codeContent))
{
    <MudPaper Class="mt-4 pa-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Code Content:</MudText>
        <MudText Style="word-break: break-all; white-space: pre-wrap; font-family: monospace;">@codeContent</MudText>
    </MudPaper>
}

@code {
    private StandaloneCodeEditor editor = null!;
    private string codeContent = string.Empty;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "csharp",
            Value = "// Write your code here\n\npublic class HelloWorld\n{\n    public static void Main()\n    {\n        Console.WriteLine(\"Hello, World!\");\n    }\n}",
            Theme = "vs",
            WordWrap = "on",
            ScrollBeyondLastLine = false,
            Minimap = new EditorMinimapOptions { Enabled = true }
        };
    }

    private async Task ClearCode()
    {
        await editor.SetValue(string.Empty);
        codeContent = string.Empty;
    }

    private async Task GetCode()
    {
        codeContent = await editor.GetValue();
    }
}
