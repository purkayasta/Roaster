@page "/code-workspace"
@using BlazorMonaco.Editor
@inject IJSRuntime JS

<PageTitle>Code Workspace</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudText Typo="Typo.h3" GutterBottom="true">GitHub-Style PR Review</MudText>
    <MudText Class="mb-6">Click on line numbers to add review comments inline.</MudText>

    <MudGrid>
        <MudItem xs="12" md="8">
            <!-- Monaco Editor Container -->
            <MudPaper Elevation="1">
                <StandaloneCodeEditor
                    @ref="editor"
                    Id="workspace-editor"
                    ConstructionOptions="EditorConstructionOptions"
                />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <!-- Sidebar with Review Instructions -->
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Add Review Comments</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Click a button below to add an inline comment thread to that line.
                </MudText>

                <MudStack Spacing="1" Class="mb-4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AddThreadToLine(5))">
                        Comment on Line 5
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AddThreadToLine(10))">
                        Comment on Line 10
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AddThreadToLine(20))">
                        Comment on Line 20
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AddThreadToLine(25))">
                        Comment on Line 25
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6" GutterBottom="true">Active Threads</MudText>
                @if (activeThreads.Count == 0)
                {
                    <MudText Typo="Typo.body2">
                        No review comments yet. Add one to start.
                    </MudText>
                }
                else
                {
                    @foreach (var thread in activeThreads)
                    {
                        <MudChip T="string"
                            Text="@($"Line {thread}")"
                            OnClose="@(() => RemoveThread(thread))"
                            Class="mb-2"
                            Color="Color.Primary"
                            Variant="Variant.Text"
                        />
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<!--
    HIDDEN CONTAINER FOR BLAZOR COMPONENTS
    These divs are rendered by Blazor but hidden from view.
    They will be moved into the Monaco editor via JS Interop.

    The key strategy here:
    1. Blazor renders the RoastThread components in these hidden divs
    2. The components maintain their state and event handlers in the Blazor render tree
    3. We use JS Interop to move the DOM element into the Monaco editor
    4. The component continues to function because Blazor still tracks it
-->
<div id="roast-threads-container" style="display: none;">
    @foreach (var threadLine in renderedThreads)
    {
        <div id="roast-thread-@threadLine" style="display: none;">
            <RoastThread LineNumber="@threadLine" OnThreadClosed="@(EventCallback.Factory.Create(this, () => HandleThreadRemoved(threadLine)))" />
        </div>
    }
</div>

@code {
    private StandaloneCodeEditor editor = null!;
    private List<int> activeThreads = new();
    private List<int> renderedThreads = new();
    private IJSObjectReference? monacoInteropModule;

    /// <summary>
    /// C# sample code that will be displayed in the Monaco editor.
    /// This demonstrates a realistic code review scenario with multiple lines.
    /// </summary>
    private const string SampleCode = @"using System;
using System.Collections.Generic;
using System.Linq;

namespace GitHubPRReview
{
    public class UserService
    {
        private readonly IRepository _repository;

        public UserService(IRepository repository)
        {
            _repository = repository;
        }

        public async Task<User> GetUserByIdAsync(int id)
        {
            // TODO: Add validation for negative IDs
            var user = await _repository.GetUserAsync(id);
            return user;
        }

        public async Task CreateUserAsync(string email, string name)
        {
            if (string.IsNullOrWhiteSpace(email))
            {
                throw new ArgumentException(""Email cannot be empty"", nameof(email));
            }

            var user = new User
            {
                Email = email,
                Name = name,
                CreatedAt = DateTime.UtcNow
            };

            await _repository.SaveUserAsync(user);
        }
    }
}";

    /// <summary>
    /// Configures the Monaco Editor appearance and behavior.
    /// Uses dark theme for a modern GitHub-like experience.
    /// </summary>
    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "csharp",
            Value = SampleCode,
            Theme = "vs-dark",
            WordWrap = "on",
            ScrollBeyondLastLine = false,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "on",
            GlyphMargin = true, // Show margin for icons/indicators
            LineDecorationsWidth = 16,
            RenderLineHighlight = "line",
            FontSize = 13,
        };
    }

    /// <summary>
    /// Lifecycle: Runs after the component is initialized.
    /// Loads the Monaco JS Interop module for view zone management.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load the JavaScript module that handles Monaco view zones
            monacoInteropModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./monaco-interop.js"
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading monaco-interop.js: {ex.Message}");
        }
    }

    /// <summary>
    /// Called when user clicks a "Comment on Line X" button.
    /// Creates a new RoastThread component and injects it as a view zone.
    /// </summary>
    private async Task AddThreadToLine(int lineNumber)
    {
        // Prevent duplicate threads on the same line
        if (activeThreads.Contains(lineNumber))
        {
            return;
        }

        // Add to list of rendered threads (triggers re-render)
        renderedThreads.Add(lineNumber);
        activeThreads.Add(lineNumber);

        // Re-render the component to create the hidden div with RoastThread
        await InvokeAsync(StateHasChanged);

        // Give Blazor time to render the component before moving it
        await Task.Delay(100);

        // Now inject this component as a view zone in the Monaco editor
        await InjectZoneAsync(lineNumber, $"roast-thread-{lineNumber}");
    }

    /// <summary>
    /// Calls JavaScript Interop to move a DOM element into the Monaco editor as a view zone.
    ///
    /// This is the KEY step in the "hidden div strategy":
    /// 1. Blazor renders the RoastThread component in a hidden div
    /// 2. We get the reference to the hidden div by ID
    /// 3. JS Interop retrieves the Monaco editor instance
    /// 4. We use Monaco's changeViewZones API to insert the div as a view zone
    /// 5. The view zone appears visually in the editor, but Blazor still tracks the component
    /// </summary>
    private async Task InjectZoneAsync(int lineNumber, string elementId)
    {
        if (monacoInteropModule == null)
        {
            Console.WriteLine("Monaco Interop module not loaded yet");
            return;
        }

        try
        {
            // Call the JS function to inject the zone
            // This function will:
            // - Find the editor instance
            // - Get the DOM element by ID
            // - Create a view zone at the specified line
            // - Move the DOM element into the view zone
            await monacoInteropModule.InvokeVoidAsync(
                "injectViewZone",
                "workspace-editor",    // Editor instance ID
                lineNumber,            // Line number to add zone after
                elementId              // ID of the DOM element to move
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error injecting view zone: {ex.Message}");
        }
    }

    /// <summary>
    /// Called when a RoastThread component is removed by the user.
    /// Cleans up the thread from our tracking lists.
    /// </summary>
    private void HandleThreadRemoved(int lineNumber)
    {
        activeThreads.Remove(lineNumber);
        renderedThreads.Remove(lineNumber);
        StateHasChanged();
    }

    /// <summary>
    /// Removes a thread from the UI.
    /// Called when user clicks the close button on a thread chip.
    /// </summary>
    private void RemoveThread(int lineNumber)
    {
        HandleThreadRemoved(lineNumber);
    }
}
