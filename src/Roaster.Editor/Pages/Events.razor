@page "/events"
@inherits EditorComponentBase
@implements IDisposable
@inject EventService EventService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4" Style="height:100%; overflow-y:auto; box-sizing:border-box;">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Event Log</MudText>
        <MudSwitch T="bool" @bind-Value="@_live" @bind-Value:after="OnLiveToggled" Color="Color.Success" Label="Live" />
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTextField @bind-Value="_sessionIdInput" Placeholder="Search by Session ID" Variant="Variant.Outlined"
                      Margin="Margin.Dense" FullWidth="true" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" OnClearButtonClick="ClearSearch" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync" Disabled="Running">
            Search
        </MudButton>
    </MudStack>

    @if (Running)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
    else if (_events.Count == 0 && _page == 1)
    {
        <MudAlert Severity="Severity.Info">No events recorded yet.</MudAlert>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true">
            @foreach (var ev in _events)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudChip T="string" Color="@GetEventColor(ev.EventType)" Size="Size.Small" Variant="Variant.Filled">
                                @ev.EventType
                            </MudChip>
                            <MudText Typo="Typo.body2">@ev.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Submission #@ev.SubmissionId</MudText>
                            @if (!string.IsNullOrEmpty(ev.Language))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@ev.Language</MudChip>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Class="pa-4" Spacing="4">
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Session ID</MudText>
                                    <MudText Typo="Typo.body2">@(ev.SessionId?.ToString() ?? "—")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Submission ID</MudText>
                                    <MudText Typo="Typo.body2">@ev.SubmissionId</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Model</MudText>
                                    <MudText Typo="Typo.body2">@(ev.ModelId ?? "—")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Language</MudText>
                                    <MudText Typo="Typo.body2">@(ev.Language ?? "—")</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (ev.QueueWaitMs.HasValue)
                            {
                                <MudGrid>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Queue Wait</MudText>
                                        <MudText Typo="Typo.body2">@((ev.QueueWaitMs.Value / 1000.0).ToString("F2"))s</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Review Duration</MudText>
                                        <MudText Typo="Typo.body2">@((ev.ReviewDurationMs!.Value / 1000.0).ToString("F2"))s
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Duration</MudText>
                                        <MudText Typo="Typo.body2">@((ev.TotalDurationMs!.Value / 1000.0).ToString("F2"))s</MudText>
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (!string.IsNullOrWhiteSpace(ev.Metadata))
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Metadata</MudText>
                                    <JsonViewer Json="@ev.Metadata" />
                                </MudStack>
                            }
                        </MudStack>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>

    }

    @if (!Running)
    {
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="_page <= 1 || _live" OnClick="PrevPage" />
            <MudText Typo="Typo.body2">Page @_page</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="_events.Count < PageSize || _live"
                           OnClick="NextPage" />
        </MudStack>
    }
</MudContainer>

@code {
    private const int PageSize = 30;
    private int _page = 1;
    private List<EventLogResponse> _events = [];
    private bool _live;
    private CancellationTokenSource? _cts;
    private PeriodicTimer? _pollTimer;
    private string _sessionIdInput = string.Empty;
    private Guid? _activeSessionId;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunLogException(async () => await FetchAsync());
    }

    private async Task FetchAsync()
    {
        var result = await EventService.GetAllAsync(page: _page, pageSize: PageSize, sessionId: _activeSessionId);
        if (result.IsSuccess)
            _events = result.Data ?? [];
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionIdInput))
        {
            await ClearSearch();
            return;
        }

        if (!Guid.TryParse(_sessionIdInput.Trim(), out var parsed))
        {
            Snackbar.Add("Invalid Session ID format.", Severity.Warning);
            return;
        }

        _activeSessionId = parsed;
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearSearch()
    {
        _sessionIdInput = string.Empty;
        _activeSessionId = null;
        _page = 1;
        await LoadAsync();
    }

    private void OnLiveToggled()
    {
        if (_live) StartPolling();
        else StopPolling();
    }

    private void StartPolling()
    {
        _page = 1;
        _cts = new CancellationTokenSource();
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await _pollTimer.WaitForNextTickAsync(token))
            {
                try { await FetchAsync(); StateHasChanged(); }
                catch { }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _pollTimer.Dispose();
            _pollTimer = null;
        }
    }

    private void StopPolling()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }

    public void Dispose() => StopPolling();

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private static Color GetEventColor(string eventType) => eventType switch
    {
        "Submitted" => Color.Info,
        "ProcessingStarted" => Color.Warning,
        "ReviewCompleted" => Color.Success,
        "Failed" => Color.Error,
        "UserReplied" => Color.Primary,
        "AiReplied" => Color.Secondary,
        _ => Color.Default
    };
}
