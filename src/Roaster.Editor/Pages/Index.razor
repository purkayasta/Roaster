@page "/"
@inherits EditorComponentBase
@inject SessionService SessionService

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Sessions</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="OpenNewSessionDialog">
            New
        </MudButton>
    </MudStack>

    @if (Running)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 60vh;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        <SessionView Sessions="_sessions" PageSize="20" OnEdit="EditSessionAsync" OnDelete="DeleteSessionAsync" />
    }
</MudContainer>

@code {
    private List<SessionSubmissionResponse> _sessions = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await RunLogException(async () =>
        {
            var result = await SessionService.GetAllAsync(pageSize: 50);
            if (result.IsSuccess)
                _sessions = result.Data ?? [];
            else
                Snackbar.Add(result.Error ?? $"Failed to load sessions ({result.StatusCode}).", Severity.Error);
        });
    }

    private async Task OpenNewSessionDialog()
    {
        var dialog = await DialogService.ShowAsync<NewSessionDialog>("New Code Session");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: NewSessionResult newSession })
        {
            await RunLogException(async () =>
            {
                var response = await SessionService.CreateAsync(newSession.Name);
                if (response.IsSuccess)
                {
                    var url = newSession.IsMulti
                        ? $"/session/{response.Data!.Id}?mode=multi"
                        : $"/session/{response.Data!.Id}";
                    Navigation.NavigateTo(url);
                }
                else
                    Snackbar.Add(response.Error ?? $"Failed to create session ({response.StatusCode}).", Severity.Error);
            });
        }
    }

    private void EditSessionAsync(Guid sessionId)
    {
        var session = _sessions.FirstOrDefault(s => s.SessionId == sessionId);
        var url = session?.IsMultiFile == true
            ? $"/session/{sessionId}?mode=multi"
            : $"/session/{sessionId}";
        Navigation.NavigateTo(url);
    }

    private async Task DeleteSessionAsync(Guid sessionId)
    {
        await RunLogException(async () =>
        {
            var result = await SessionService.DeleteAsync(sessionId);
            if (result.IsSuccess)
                _sessions.RemoveAll(s => s.SessionId == sessionId);
            else
                Snackbar.Add(result.Error ?? $"Failed to delete session ({result.StatusCode}).", Severity.Error);
        });
    }
}
