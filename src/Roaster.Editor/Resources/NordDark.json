{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "",                    "foreground": "D8DEE9"                    },
    { "token": "comment",             "foreground": "616E88", "fontStyle": "italic" },
    { "token": "keyword",             "foreground": "81A1C1"                    },
    { "token": "keyword.control",     "foreground": "81A1C1"                    },
    { "token": "keyword.operator",    "foreground": "81A1C1"                    },
    { "token": "storage",             "foreground": "81A1C1"                    },
    { "token": "string",              "foreground": "A3BE8C"                    },
    { "token": "string.escape",       "foreground": "EBCB8B"                    },
    { "token": "number",              "foreground": "B48EAD"                    },
    { "token": "constant",            "foreground": "D08770"                    },
    { "token": "type",                "foreground": "8FBCBB"                    },
    { "token": "type.identifier",     "foreground": "8FBCBB"                    },
    { "token": "class",               "foreground": "8FBCBB"                    },
    { "token": "interface",           "foreground": "8FBCBB"                    },
    { "token": "struct",              "foreground": "8FBCBB"                    },
    { "token": "function",            "foreground": "88C0D0"                    },
    { "token": "identifier",          "foreground": "D8DEE9"                    },
    { "token": "variable",            "foreground": "D8DEE9"                    },
    { "token": "operator",            "foreground": "81A1C1"                    },
    { "token": "delimiter",           "foreground": "ECEFF4"                    },
    { "token": "tag",                 "foreground": "81A1C1"                    },
    { "token": "attribute.name",      "foreground": "8FBCBB"                    },
    { "token": "attribute.value",     "foreground": "A3BE8C"                    },
    { "token": "regexp",              "foreground": "EBCB8B"                    },
    { "token": "invalid",             "foreground": "BF616A"                    }
  ],
  "colors": {
    "editor.background":                  "#2E3440",
    "editor.foreground":                  "#D8DEE9",
    "editor.lineHighlightBackground":     "#3B4252",
    "editor.selectionBackground":         "#4C566A",
    "editor.inactiveSelectionBackground": "#434C5E",
    "editorLineNumber.foreground":        "#4C566A",
    "editorLineNumber.activeForeground":  "#D8DEE9",
    "editorCursor.foreground":            "#D8DEE9",
    "editorWhitespace.foreground":        "#4C566A",
    "editorIndentGuide.background1":      "#3B4252",
    "editorIndentGuide.activeBackground1":"#4C566A",
    "editor.findMatchBackground":         "#EBCB8B40",
    "editor.findMatchHighlightBackground":"#EBCB8B20",
    "editorBracketMatch.background":      "#4C566A",
    "editorBracketMatch.border":          "#81A1C1",
    "scrollbarSlider.background":         "#4C566A80",
    "scrollbarSlider.hoverBackground":    "#4C566ABB",
    "scrollbarSlider.activeBackground":   "#4C566AFF"
  }
}
