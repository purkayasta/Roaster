<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Code Session</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Placeholder="Enter session name" Required="true"
                      RequiredError="Name is required" Immediate="true" Class="mb-4" />
        <MudToggleGroup T="bool" @bind-Value="_isMulti" Color="Color.Primary" Outlined="true">
            <MudToggleItem Value="false">Single file</MudToggleItem>
            <MudToggleItem Value="true">Multi file</MudToggleItem>
        </MudToggleGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_name)"
                   OnClick="Confirm">
            Start Now
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _name = string.Empty;
    private bool _isMulti;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(new NewSessionResult(_name, _isMulti));
}
